# ============================================================
# ARF Commerce - Environment Variables Template
# Copy to .env.local and fill in your actual values
# NEVER commit .env.local to git
# ============================================================

# ============================================================
# STRIPE
# Get from: https://dashboard.stripe.com/apikeys
# Use pk_test_... / sk_test_... for development
# Use pk_live_... / sk_live_... for production
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Webhook signing secret - from: https://dashboard.stripe.com/webhooks
# Create webhook pointing to: https://yourdomain.com/api/webhooks/stripe
# Events to listen for: checkout.session.completed, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================
# RESEND (Transactional Emails)
# Get from: https://resend.com/api-keys
# Verify your sending domain at: https://resend.com/domains
# ============================================================
RESEND_API_KEY=re_your_api_key_here
# The verified sending domain address
RESEND_FROM_EMAIL=orders@arfcommerce.co.uk
RESEND_FROM_NAME=ARF Commerce

# ============================================================
# MAILCHIMP (Newsletter / Marketing)
# Get API key from: https://mailchimp.com/developer/marketing/guides/quick-start/
# Get List ID from: Audience > Settings > Audience name and defaults > Audience ID
# ============================================================
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_mailchimp_audience_id
# Your Mailchimp data center (e.g., us1, us2, us6 - from your API key suffix)
MAILCHIMP_SERVER_PREFIX=us1

# ============================================================
# ANALYTICS & TRACKING
# ============================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1234567890123456
NEXT_PUBLIC_TIKTOK_PIXEL_ID=YOUR_TIKTOK_PIXEL_ID

# ============================================================
# AMAZON AFFILIATE
# ============================================================
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=yourtag-21

# ============================================================
# BUSINESS CONFIGURATION
# ============================================================
BUSINESS_EMAIL=orders@arfcommerce.co.uk
SUPPORT_EMAIL=support@arfcommerce.co.uk
# Inbox that receives new-order and contact-form notifications
ADMIN_NOTIFICATION_EMAIL=orders@arfcommerce.co.uk
# FixNow Mechanics inbox. Gets a fitting job email for orders that include fitting
FIXNOW_EMAIL=replace-with-fixnow-inbox@example.com
# Registered office address from Companies House (shown in the footer, policies and emails;
# UK law requires it on the website). Company name/number are set in lib/site-config.ts.
NEXT_PUBLIC_REGISTERED_OFFICE=
# Your site URL (no trailing slash) - used in email links
NEXT_PUBLIC_SITE_URL=https://arfcommerce.co.uk

# ============================================================
# EBAY
# Your eBay seller username, used for "View on eBay" links
# ============================================================
NEXT_PUBLIC_EBAY_SELLER=arfcommerce
# Optional: override the eBay store link (defaults to https://www.ebay.co.uk/usr/<seller>)
# NEXT_PUBLIC_EBAY_STORE_URL=https://www.ebay.co.uk/str/yourstore
